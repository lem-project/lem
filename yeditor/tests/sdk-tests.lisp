(defpackage :yeditor-sdk/tests
  (:use :cl)
  (:export #:run-tests))
(in-package :yeditor-sdk/tests)

(defvar *state* nil)

(defun signals-error-p (function)
  (handler-case (progn (funcall function) nil)
    (error () t)))

(defun test-toggle-identity ()
  (let* ((yeditor-sdk:*component-registry* (yeditor-sdk:make-registry))
         (*state* nil)
         (configuration (list :enabled t))
         (context (list :workspace :test))
         (install-count 0))
    (yeditor-sdk:define-component dummy (:configuration configuration)
      (:install (component ctx)
        (assert (eq ctx context))
        (incf install-count)
        (dotimes (i 10)
          (let ((value i))
            (yeditor-sdk:effect component :dummy
                               (lambda () (push value *state*))
                               :undo-thunk (lambda () (pop *state*)))))))
    (assert (null (yeditor-sdk:registry-log)))
    (assert (eq :registered (yeditor-sdk:component-state
                            (yeditor-sdk:find-component 'dummy))))
    (let* ((component (yeditor-sdk:install-component 'dummy :context context))
           (handles (yeditor-sdk:component-handles component)))
      (assert (= 10 (length handles)))
      (let* ((entry (first (yeditor-sdk:registry-log)))
             (record (cdr (assoc :record entry))))
        (assert (eq 'dummy (cdr (assoc :component entry))))
        (assert (eq component (cdr (assoc :owner record))))
        (assert (eq :dummy (cdr (assoc :kind record))))
        (setf (cdr (assoc :kind record)) :changed)
        (assert (eq :dummy (cdr (assoc :kind (cdr (assoc :record
                                  (first (yeditor-sdk:registry-log)))))))))
      (dotimes (cycle 1000)
        (assert (equal '(9 8 7 6 5 4 3 2 1 0) *state*))
        (assert (= 10 (length (yeditor-sdk:registry-log))))
        (yeditor-sdk:toggle-component 'dummy)
        (assert (eq :suspended (yeditor-sdk:component-state component)))
        (assert (null *state*))
        (assert (null (yeditor-sdk:registry-log)))
        (assert (eq component (yeditor-sdk:find-component 'dummy)))
        (assert (eq configuration (yeditor-sdk:component-configuration component)))
        (yeditor-sdk:toggle-component 'dummy)
        (assert (eq :active (yeditor-sdk:component-state component)))
        (assert (every #'eq handles (yeditor-sdk:component-handles component)))
        (assert (every #'eq handles
                       (mapcar (lambda (entry) (cdr (assoc :handle entry)))
                               (yeditor-sdk:registry-log)))))
      (assert (= 1 install-count))
      (yeditor-sdk:uninstall-component 'dummy)
      (assert (eq :uninstalled (yeditor-sdk:component-state component)))
      (assert (null *state*))
      (assert (null (yeditor-sdk:registry-log)))
      (assert (null (yeditor-sdk:component-handles component)))
      (yeditor-sdk:uninstall-component 'dummy))))

(defun test-install-failure ()
  (let ((yeditor-sdk:*component-registry* (yeditor-sdk:make-registry))
        (*state* 0)
        (fail-p t))
    (yeditor-sdk:define-component broken ()
      (:install (component context)
        (declare (ignore context))
        (yeditor-sdk:effect component :first (lambda () (incf *state*))
                           :undo-thunk (lambda () (decf *state*)))
        (yeditor-sdk:effect component :second
                           (lambda () (incf *state* 10)
                             (when fail-p (error "partial installation")))
                           :undo-thunk (lambda () (decf *state* 10)))))
    (assert (signals-error-p (lambda () (yeditor-sdk:install-component 'broken))))
    (assert (zerop *state*))
    (assert (null (yeditor-sdk:registry-log)))
    (assert (eq :registered (yeditor-sdk:component-state
                            (yeditor-sdk:find-component 'broken))))
    (setf fail-p nil)
    (yeditor-sdk:install-component 'broken)
    (assert (= 11 *state*))
    (yeditor-sdk:uninstall-component 'broken)
    (assert (zerop *state*))))

(defun test-definition-failure-and-nonlocal-exit ()
  (dolist (exit-kind '(:error :throw))
    (let ((yeditor-sdk:*component-registry* (yeditor-sdk:make-registry))
          (*state* nil))
      (yeditor-sdk:define-component broken ()
        (:install (component context)
          (declare (ignore context))
          (yeditor-sdk:effect component :dummy (lambda () (push :leak *state*))
                             :undo-thunk (lambda () (pop *state*)))
          (if (eq exit-kind :error) (error "definition failed") (throw 'abort :exit))))
      (if (eq exit-kind :error)
          (assert (signals-error-p (lambda () (yeditor-sdk:install-component 'broken))))
          (assert (eq :exit (catch 'abort (yeditor-sdk:install-component 'broken)))))
      (assert (null *state*))
      (assert (null (yeditor-sdk:registry-log)))
      (assert (eq :registered (yeditor-sdk:component-state
                              (yeditor-sdk:find-component 'broken))))
      ;; The registry transition guard must have been released.
      (yeditor-sdk:define-component next ()
        (:install (component context) (declare (ignore component context))))
      (yeditor-sdk:install-component 'next)
      (yeditor-sdk:uninstall-component 'next))))

(defun test-resume-failure ()
  (let ((yeditor-sdk:*component-registry* (yeditor-sdk:make-registry))
        (*state* 0)
        (fail-p nil))
    (yeditor-sdk:define-component retry ()
      (:install (component context)
        (declare (ignore context))
        (yeditor-sdk:effect component :dummy
                           (lambda () (incf *state*) (when fail-p (error "resume failed")))
                           :undo-thunk (lambda () (decf *state*)))))
    (let* ((component (yeditor-sdk:install-component 'retry))
           (handle (first (yeditor-sdk:component-handles component))))
      (yeditor-sdk:suspend-component 'retry)
      (setf fail-p t)
      (assert (signals-error-p (lambda () (yeditor-sdk:resume-component 'retry))))
      (assert (zerop *state*))
      (assert (null (yeditor-sdk:registry-log)))
      (assert (eq :suspended (yeditor-sdk:component-state component)))
      (setf fail-p nil)
      (yeditor-sdk:resume-component 'retry)
      (assert (eq handle (first (yeditor-sdk:component-handles component))))
      (assert (= 1 *state*))
      (yeditor-sdk:uninstall-component 'retry)
      (assert (zerop *state*)))))

(defun test-suspend-failure ()
  (let ((yeditor-sdk:*component-registry* (yeditor-sdk:make-registry))
        (*state* 0)
        (fail-p t))
    (yeditor-sdk:define-component retry ()
      (:install (component context)
        (declare (ignore context))
        (yeditor-sdk:effect component :dummy (lambda () (incf *state*))
                           :undo-thunk (lambda () (when fail-p (error "inverse failed"))
                                         (decf *state*)))))
    (let ((component (yeditor-sdk:install-component 'retry)))
      (assert (signals-error-p (lambda () (yeditor-sdk:suspend-component 'retry))))
      (assert (eq :failed (yeditor-sdk:component-state component)))
      (assert (= 1 (length (yeditor-sdk:registry-log))))
      (assert (signals-error-p (lambda () (yeditor-sdk:resume-component 'retry))))
      (setf fail-p nil)
      (yeditor-sdk:suspend-component 'retry)
      (assert (zerop *state*))
      (assert (null (yeditor-sdk:registry-log)))
      (yeditor-sdk:resume-component 'retry)
      (assert (= 1 *state*))
      (yeditor-sdk:uninstall-component 'retry)
      (assert (zerop *state*)))))

(defun test-failed-install-cleanup-is-explicit ()
  (let ((yeditor-sdk:*component-registry* (yeditor-sdk:make-registry))
        (*state* 0)
        (undo-count 0)
        (fail-p t))
    (yeditor-sdk:define-component broken ()
      (:install (component context)
        (declare (ignore context))
        (yeditor-sdk:effect component :dummy
                           (lambda () (incf *state*) (error "installer failed"))
                           :undo-thunk (lambda () (incf undo-count)
                                         (when fail-p (error "inverse failed"))
                                         (decf *state*)))))
    (assert (signals-error-p (lambda () (yeditor-sdk:install-component 'broken))))
    (assert (= 1 undo-count))
    (assert (= 1 *state*))
    (assert (= 1 (length (yeditor-sdk:registry-log))))
    (assert (eq :failed (yeditor-sdk:component-state
                        (yeditor-sdk:find-component 'broken))))
    (setf fail-p nil)
    (yeditor-sdk:uninstall-component 'broken)
    (assert (= 2 undo-count))
    (assert (zerop *state*))
    (assert (null (yeditor-sdk:registry-log)))))

(defun test-reentrancy-and-context-guard ()
  (let ((yeditor-sdk:*component-registry* (yeditor-sdk:make-registry))
        (context (list :original)))
    (yeditor-sdk:define-component other ()
      (:install (component ctx) (declare (ignore component ctx))))
    (yeditor-sdk:define-component recursive ()
      (:install (component ctx)
        (declare (ignore component ctx))
        (yeditor-sdk:install-component 'other)))
    (assert (signals-error-p (lambda () (yeditor-sdk:install-component 'recursive))))
    (assert (eq :registered (yeditor-sdk:component-state
                            (yeditor-sdk:find-component 'other))))
    (let ((component (yeditor-sdk:install-component 'other :context context)))
      (assert (eq component (yeditor-sdk:install-component 'other :context context)))
      (assert (signals-error-p
               (lambda () (yeditor-sdk:install-component 'other :context (list :new)))))
      (yeditor-sdk:uninstall-component 'other))))

(defun test-workspace-replay ()
  (let ((yeditor-sdk:*component-registry* (yeditor-sdk:make-registry))
        (*state* nil))
    (yeditor-sdk:define-component grouped ()
      (:install (component context)
        (declare (ignore context))
        (yeditor-tx:with-workspace-transaction (component)
          (yeditor-sdk:effect component :dummy (lambda () (push :group *state*))
                             :undo-thunk (lambda () (pop *state*))))))
    (yeditor-sdk:install-component 'grouped)
    (dotimes (cycle 100)
      (yeditor-sdk:toggle-component 'grouped)
      (assert (null *state*))
      (yeditor-sdk:toggle-component 'grouped)
      (assert (equal '(:group) *state*)))
    (yeditor-sdk:uninstall-component 'grouped)
    (assert (null *state*))))

(defun test-registry-isolation-and-validation ()
  (let ((yeditor-sdk:*component-registry* (yeditor-sdk:make-registry))
        (*state* nil))
    (yeditor-sdk:define-component first ()
      (:install (component context)
        (declare (ignore context))
        (yeditor-sdk:effect component :dummy (lambda () (push :first *state*))
                           :undo-thunk (lambda () (setf *state* (remove :first *state*))))))
    (yeditor-sdk:define-component second ()
      (:install (component context)
        (declare (ignore context))
        (yeditor-sdk:effect component :dummy (lambda () (push :second *state*))
                           :undo-thunk (lambda () (setf *state* (remove :second *state*))))))
    (yeditor-sdk:install-component 'first)
    (yeditor-sdk:install-component 'second)
    (yeditor-sdk:suspend-component 'first)
    (assert (equal '(:second) *state*))
    (assert (= 1 (length (yeditor-sdk:registry-log))))
    (assert (signals-error-p
             (lambda () (yeditor-sdk:register-component 'second (lambda (c x) (declare (ignore c x)))))))
    (assert (null (yeditor-sdk:find-component 'first :registry (yeditor-sdk:make-registry))))
    (assert (signals-error-p (lambda () (yeditor-sdk:install-component 'unknown))))
    (yeditor-sdk:uninstall-component 'first)
    (yeditor-sdk:uninstall-component 'second)
    (assert (null *state*))))

(defun run-tests ()
  "Run the registry acceptance tests and repeatable lifecycle failure checks."
  (mapc #'funcall '(test-toggle-identity test-install-failure
                   test-definition-failure-and-nonlocal-exit test-resume-failure
                   test-suspend-failure test-failed-install-cleanup-is-explicit
                   test-reentrancy-and-context-guard test-workspace-replay
                   test-registry-isolation-and-validation))
  (format t "T3: 9 test groups passed; 1000 suspend/resume cycles preserve 10 handles.~%")
  t)
