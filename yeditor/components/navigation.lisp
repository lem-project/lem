(defpackage :yeditor-components/navigation
  (:use :cl :lem :yeditor-context :yeditor-effects)
  (:export #:le-navigation #:navigation-action #:navigation-status
           #:yeditor-navigation-home #:yeditor-navigation-search))
(in-package :yeditor-components/navigation)

(defvar *navigation* nil)
(defvar *navigation-counter* 0)
(defstruct navigation
  root editor page bar header tree original-side original-side-buffer original-side-width
  preview files query candidates loading error token worker
  browser browser-dirs browser-token browser-loading browser-error return-buffer pending-close signature alive)

(defclass navigation-header (header-window) ())
(defmethod header-window-height ((window navigation-header)) 3)

(define-major-mode navigation-mode () (:name "Arquivos" :keymap *navigation-keymap*)
  (setf (buffer-read-only-p (current-buffer)) t))

(defun active-navigation ()
  (or (and *navigation* (navigation-alive *navigation*) *navigation*)
      (editor-error "A navegação de arquivos não está ativa.")))

(defun editor-window-for (state)
  (let ((window (navigation-editor state)))
    (if (and window (not (deleted-window-p window))) window
        (setf (navigation-editor state)
              (find-if (lambda (w) (and (not (typep w 'side-window))
                                       (not (header-window-p w)))) (window-list))))))

(defun editor-buffer (state)
  (let ((buffer (window-buffer (editor-window-for state))))
    (if (eq buffer (navigation-page state)) (navigation-return-buffer state) buffer)))

(defun show-in-editor (state buffer)
  (switch-to-window (editor-window-for state))
  (switch-to-buffer buffer))

(defun project-history ()
  (let ((*read-eval* nil))
    (lem/common/history:make-history :pathname (merge-pathnames "history/yeditor-projects" (uiop:ensure-directory-pathname (lem-home))) :limit 15)))

(defun recent-projects ()
  (remove-duplicates (append (reverse (lem/common/history:history-data-list (project-history)))
                             (lem-core/commands/project:saved-projects)) :test #'equal))

(defun file-buffers ()
  (remove-if-not (lambda (b) (and (buffer-filename b) (not (deleted-buffer-p b)))) (buffer-list)))

(defun short-label (text &optional (width 22))
  (if (> (length text) width) (concatenate 'string (subseq text 0 (- width 3)) "...") text))

(defun action-button (point label action &key path query)
  (lem/button:insert-button point (format nil "[~A]" label)
                            (lambda () (navigation-action action :path path :query query))
                            :nav-action action :nav-path path :without-mouse-hover-highlight t)
  (insert-string point " "))

(defun preview-p (state buffer) (eq buffer (navigation-preview state)))

(defun pin-preview (state)
  (setf (navigation-preview state) nil))

(defun refresh-bar (state)
  (let ((buffer (navigation-bar state)))
    (with-buffer-read-only buffer nil
      (erase-buffer buffer)
      (with-point ((p (buffer-start-point buffer) :left-inserting))
        (action-button p "Abrir pasta" "browse")
        (action-button p "Arquivos (F2)" "home")
        (action-button p "Abrir arquivo (F3)" "search")
        (action-button p "Foco" "focus")
        (insert-character p #\newline)
        (insert-string p (format nil "Projeto: ~A~%" (short-label (namestring (navigation-root state)) (- (display-width) 10))))
        (dolist (file (subseq (file-buffers) 0 (min 2 (length (file-buffers)))))
          (action-button p (format nil "~A~A~A" (short-label (buffer-name file) 17)
                                   (if (buffer-modified-p file) " *" "")
                                   (if (preview-p state file) " prévia" ""))
                         "open" :path (namestring (buffer-filename file))))
        (action-button p "Abas" "home")
        (action-button p "Fixar" "pin")
        (action-button p "Fechar" "close"))
      (buffer-start (buffer-point buffer)))))

(defun render-page (state)
  (let ((buffer (navigation-page state)))
    (with-buffer-read-only buffer nil
      (let ((line (line-number-at-point (buffer-point buffer))))
        (erase-buffer buffer)
        (with-point ((p (buffer-start-point buffer) :left-inserting))
          (insert-string p (format nil "Yeditor — Arquivos~%Projeto: ~A~%~%" (navigation-root state)))
          (cond
            ((navigation-pending-close state)
             (insert-string p (format nil "~A tem alterações não salvas.~%" (buffer-name (navigation-pending-close state))))
             (action-button p "Salvar e fechar" "save-close")
             (action-button p "Descartar alterações" "discard")
             (action-button p "Cancelar" "cancel"))
            ((navigation-browser state)
             (insert-string p (format nil "Escolher pasta: ~A~%" (navigation-browser state)))
             (action-button p "Abrir esta pasta" "project" :path (namestring (navigation-browser state)))
             (action-button p "Pasta acima" "browse" :path (namestring (uiop:pathname-parent-directory-pathname (navigation-browser state))))
             (action-button p "Cancelar" "cancel")
             (insert-string p (format nil "~%Clique em uma pasta para navegar:~%"))
             (when (navigation-browser-loading state) (insert-string p (format nil "Carregando pastas...~%")))
             (when (navigation-browser-error state) (insert-string p (format nil "~A~%" (navigation-browser-error state))))
             (dolist (dir (navigation-browser-dirs state))
               (action-button p (file-namestring (pathname (string-right-trim "/" (namestring dir)))) "browse" :path (namestring dir))
               (insert-character p #\newline)))
            (t
             (action-button p "Abrir projeto/pasta" "browse")
             (action-button p "Abrir arquivo / buscar" "search")
             (action-button p "Mostrar árvore" "tree")
             (action-button p "Voltar ao editor" "cancel")
             (insert-string p (format nil "~%~%Arquivos abertos — * modificado; prévia substituível~%"))
             (dolist (file (file-buffers))
               (action-button p (format nil "~A~A~A" (enough-namestring (buffer-filename file) (navigation-root state))
                                        (if (buffer-modified-p file) " *" "") (if (preview-p state file) " (prévia)" " (fixado)"))
                              "open" :path (namestring (buffer-filename file)))
               (action-button p "Fixar" "pin" :path (namestring (buffer-filename file)))
               (action-button p "Fechar" "close" :path (namestring (buffer-filename file)))
               (insert-character p #\newline))
             (insert-string p (format nil "~%Busca: ~A~%" (or (navigation-query state) "")))
             (action-button p "Editar busca" "search")
             (action-button p "Atualizar índice" "refresh")
             (insert-character p #\newline)
             (cond ((navigation-loading state) (insert-string p (format nil "Indexando em segundo plano...~%")))
                   ((navigation-error state) (insert-string p (format nil "Busca indisponível: ~A~%" (navigation-error state))))
                   (t (let ((matches (remove-if-not
                                      (lambda (name) (search (or (navigation-query state) "") name :test #'char-equal))
                                      (navigation-candidates state))))
                        (loop :for name :in matches :repeat 80
                              :do (action-button p name "preview" :path name) (insert-character p #\newline))
                        (when (> (length matches) 80) (insert-string p (format nil "Refine a busca para ver mais resultados.~%"))))))
             (insert-string p (format nil "~%Projetos recentes~%"))
             (dolist (path (recent-projects))
               (if (uiop:directory-exists-p path)
                   (action-button p path "project" :path path)
                   (insert-string p (format nil "Indisponível: ~A — escolha outra pasta.~%" path)))
               (insert-character p #\newline))
             (insert-string p (format nil "~%Arquivos recentes~%"))
             (dolist (path (subseq (lem-core/commands/file:recent-files) 0
                                  (min 12 (length (lem-core/commands/file:recent-files)))))
               (if (uiop:file-exists-p path)
                   (action-button p path "preview" :path path)
                   (insert-string p (format nil "Indisponível: ~A — movido ou removido.~%" path)))
               (insert-character p #\newline))))
          (buffer-unmark buffer)
          (move-to-line (buffer-point buffer) line))))))

(defun render-navigation (state)
  (when (navigation-alive state) (refresh-bar state) (render-page state)))

(defun show-home (state)
  (unless (eq (window-buffer (editor-window-for state)) (navigation-page state))
    (setf (navigation-return-buffer state) (editor-buffer state)))
  (render-navigation state)
  (show-in-editor state (navigation-page state)))

(defun collect-files (root token)
  (let ((seen (make-hash-table :test #'equal)) (files nil))
    (labels ((visit (dir)
               (when (car token)
                 (let ((real (ignore-errors (truename dir))))
                   (when (and real (uiop:subpathp real root) (not (gethash real seen)))
                     (setf (gethash real seen) t)
                     (dolist (file (uiop:directory-files dir))
                       (when (car token) (push (enough-namestring file root) files)))
                     (dolist (sub (uiop:subdirectories dir))
                       (unless (member (car (last (pathname-directory sub)))
                                       '(".git" ".qlot" "node_modules" ".cache" ".venv") :test #'equal)
                         (visit sub))))))))
      (visit root))
    (sort files #'string-lessp)))

(defun start-index (state)
  (when (navigation-token state) (setf (car (navigation-token state)) nil))
  (let ((token (list t)) (root (navigation-root state)))
    (setf (navigation-token state) token (navigation-loading state) t (navigation-error state) nil)
    (setf (navigation-worker state)
          (bt2:make-thread
           (lambda ()
             (let ((files nil) (failure nil))
               (handler-case (setf files (collect-files root token))
                 (error (c) (setf failure (princ-to-string c))))
               (when (car token)
                 (send-event
                  (lambda ()
                    (when (and (navigation-alive state) (eq token (navigation-token state)))
                      (setf (navigation-candidates state) files (navigation-loading state) nil
                            (navigation-error state) failure)
                      (render-navigation state)))))))
           :name "yeditor-navigation-index"))))

(defun start-browser (state directory)
  (unless (uiop:directory-exists-p directory)
    (editor-error "Pasta indisponível: ~A. Escolha outra pasta." directory))
  (when (navigation-browser-token state) (setf (car (navigation-browser-token state)) nil))
  (let ((token (list t)) (root (uiop:ensure-directory-pathname directory)))
    (setf (navigation-browser state) root (navigation-browser-token state) token
          (navigation-browser-dirs state) nil (navigation-browser-error state) nil
          (navigation-browser-loading state) t)
    (bt2:make-thread
     (lambda ()
       (let ((dirs nil) (failure nil))
         (handler-case (setf dirs (sort (uiop:subdirectories root) #'string-lessp :key #'namestring))
           (error (condition) (setf failure (princ-to-string condition))))
         (when (car token)
           (send-event
            (lambda ()
              (when (and (navigation-alive state) (eq token (navigation-browser-token state)))
                (setf (navigation-browser-dirs state) dirs (navigation-browser-loading state) nil
                      (navigation-browser-error state) failure)
                (render-navigation state)))))))
     :name "yeditor-navigation-folders")))

(defun show-tree (state)
  (unless (and (navigation-tree state) (not (deleted-buffer-p (navigation-tree state))))
    (let ((buffer (make-buffer (format nil "*Yeditor árvore ~D*" (incf *navigation-counter*)) :temporary t)))
      (setf (navigation-tree state) buffer)
      (change-buffer-mode buffer 'lem/filer:filer-mode)
      (lem/filer:render buffer (lem/filer:create-directory-item (navigation-root state) :open t))))
  (make-leftside-window (navigation-tree state) :width (min 32 (floor (display-width) 3))))

(defun open-project (state path)
  (let ((root (uiop:directory-exists-p (uiop:ensure-directory-pathname path))))
    (unless root (editor-error "Pasta indisponível: ~A. Escolha outra pasta." path))
    (setf root (truename root))
    (setf (navigation-root state) root (navigation-browser state) nil
          (navigation-query state) "" (navigation-candidates state) nil)
    (when (navigation-tree state)
      (let ((old (navigation-tree state)))
        (setf (navigation-tree state) nil)
        (show-tree state)
        (delete-buffer old)))
    (show-tree state)
    (let ((history (project-history)))
      (lem/common/history:add-history history (namestring root) :allow-duplicates nil :move-to-top t)
      (lem/common/history:save-file history))
    (start-index state)
    (show-home state)))

(defun open-file (state path preview)
  (let* ((path (merge-pathnames path (navigation-root state)))
         (exists (uiop:file-exists-p path)))
    (unless exists (editor-error "Arquivo movido ou removido: ~A. Atualize a busca ou escolha outro arquivo." path))
    (let* ((borrowed (get-file-buffer path))
           (old (navigation-preview state))
           (buffer (or borrowed (find-file-buffer path))))
      (when (and old (not (eq old buffer)) (not (deleted-buffer-p old)))
        (when (and (not (buffer-modified-p old))
                   (not (remove (editor-window-for state) (get-buffer-windows old))))
          (delete-buffer old)))
      (setf (navigation-preview state) (and preview (not borrowed) buffer))
      (show-in-editor state buffer)
      (setf (navigation-return-buffer state) buffer))))

(defun close-file-now (state buffer discard)
  (when discard (buffer-unmark buffer))
  (delete-buffer buffer)
  (when (eq buffer (navigation-preview state)) (pin-preview state))
  (setf (navigation-pending-close state) nil)
  (let ((next (first (file-buffers))))
    (if next (progn (setf (navigation-return-buffer state) next) (show-in-editor state next))
        (progn (setf (navigation-return-buffer state) nil) (show-home state)))))

(defun navigation-action (action &key path query)
  "Execute the same navigation action for buttons, commands and MCP; return UI state.
Closing modified files asks through visible Save/Discard/Cancel actions."
  (let ((state (active-navigation)))
    (cond
      ((equal action "home") (setf (navigation-browser state) nil) (show-home state))
      ((equal action "browse")
       (start-browser state (or path (navigation-root state)))
       (show-home state))
      ((equal action "project")
       (if path (open-project state path) (navigation-action "browse")))
      ((equal action "tree") (show-tree state))
      ((equal action "focus")
       (let ((side (frame-leftside-window (current-frame))))
         (when (and side (eq (window-buffer side) (navigation-tree state))) (delete-leftside-window))))
      ((member action '("open" "preview") :test #'equal)
       (unless path (editor-error "Escolha um arquivo."))
       (open-file state path (equal action "preview")))
      ((equal action "pin")
       (when (eq (if path (get-file-buffer (merge-pathnames path (navigation-root state))) (editor-buffer state))
                 (navigation-preview state))
         (pin-preview state)))
      ((equal action "close")
       (let ((buffer (if path (get-file-buffer (merge-pathnames path (navigation-root state))) (editor-buffer state))))
         (unless (and buffer (buffer-filename buffer)) (editor-error "Escolha uma aba de arquivo para fechar."))
         (if (buffer-modified-p buffer)
             (progn (setf (navigation-pending-close state) buffer) (show-home state))
             (close-file-now state buffer nil))))
      ((member action '("save-close" "discard") :test #'equal)
       (let ((buffer (navigation-pending-close state)))
         (unless buffer (editor-error "Não há fechamento pendente."))
         (when (equal action "save-close") (save-buffer buffer))
         (close-file-now state buffer (equal action "discard"))))
      ((equal action "cancel")
       (setf (navigation-pending-close state) nil (navigation-browser state) nil)
       (let ((buffer (navigation-return-buffer state)))
         (when (and buffer (not (deleted-buffer-p buffer))) (show-in-editor state buffer))))
      ((equal action "search")
       (unless (or (navigation-loading state) (navigation-candidates state)) (start-index state))
       (setf (navigation-query state) (or query (prompt-for-string "Nome ou caminho do arquivo: " :initial-value (or (navigation-query state) ""))))
       (setf (navigation-browser state) nil)
       (show-home state))
      ((equal action "refresh") (start-index state))
      (t (editor-error "Ação de arquivos desconhecida: ~A" action)))
    (render-navigation state)
    (navigation-status)))

(defun navigation-status ()
  "Return navigation metadata as an alist with stable string keys for agents."
  (let ((state (active-navigation)))
    (list (cons "project" (namestring (navigation-root state)))
          (cons "index" (if (navigation-loading state) "loading" "ready"))
          (cons "query" (or (navigation-query state) ""))
          (cons "browser" (if (navigation-browser state) (namestring (navigation-browser state)) ""))
          (cons "active_file" (let ((b (editor-buffer state)))
                                (if (and b (buffer-filename b)) (namestring (buffer-filename b)) "")))
          (cons "pending_close" (let ((b (navigation-pending-close state)))
                                  (if b (namestring (buffer-filename b)) "")))
          (cons "preview" (let ((b (navigation-preview state))) (if (and b (not (deleted-buffer-p b))) (buffer-name b) ""))))))

(define-command yeditor-navigation-home () ()
  "Show projects, open files and recent files through labelled clickable controls."
  (navigation-action "home"))
(define-command yeditor-navigation-search () ()
  "Search project filenames in the asynchronous index."
  (navigation-action "search"))
(define-command navigation-activate () ()
  (let ((button (lem/button:button-at (current-point)))) (when button (lem/button:button-action button))))
(define-command navigation-next () ()
  (or (lem/button:forward-button (current-point))
      (progn (buffer-start (current-point)) (lem/button:forward-button (current-point)))))
(define-command navigation-previous () ()
  (or (lem/button:backward-button (current-point))
      (progn (buffer-end (current-point)) (lem/button:backward-button (current-point)))))
(define-command navigation-cancel () () (navigation-action "cancel"))
(define-key *navigation-keymap* "Return" 'navigation-activate)
(define-key *navigation-keymap* "Tab" 'navigation-next)
(define-key *navigation-keymap* "S-Tab" 'navigation-previous)
(define-key *navigation-keymap* "Escape" 'navigation-cancel)

(defun after-navigation-command ()
  (when (and *navigation* (navigation-alive *navigation*))
    (let* ((state *navigation*) (preview (navigation-preview state))
           (signature (mapcar (lambda (b) (list b (buffer-modified-p b))) (file-buffers))))
      (when (and preview (or (deleted-buffer-p preview) (buffer-modified-p preview))) (pin-preview state))
      (unless (equal signature (navigation-signature state))
        (setf (navigation-signature state) signature)
        (render-navigation state)))))

(defun stop-navigation (state)
  (when state
    (setf (navigation-alive state) nil)
    (when (navigation-token state) (setf (car (navigation-token state)) nil))
    (when (navigation-browser-token state) (setf (car (navigation-browser-token state)) nil))
    (let ((side (frame-leftside-window (current-frame)))
          (original (navigation-original-side-buffer state)))
      (when (and side (eq (window-buffer side) (navigation-tree state)))
        (if (and original (not (deleted-buffer-p original)))
            (progn
              (with-current-window side (switch-to-buffer original))
              (window-set-size side (navigation-original-side-width state) (window-height side))
              (balance-windows))
            (delete-leftside-window)))
      (when (and (null (frame-leftside-window (current-frame))) original
                 (not (deleted-buffer-p original)))
        (make-leftside-window original :width (navigation-original-side-width state))))
    (when (and (navigation-header state) (member (navigation-header state) (frame-header-windows (current-frame))))
      (delete-window (navigation-header state)))
    (when (eq (window-buffer (editor-window-for state)) (navigation-page state))
      (let ((prior (navigation-return-buffer state)))
        (when (and prior (not (deleted-buffer-p prior))) (show-in-editor state prior))))
    (dolist (buffer (list (navigation-page state) (navigation-bar state) (navigation-tree state)))
      (when (and buffer (not (deleted-buffer-p buffer))) (delete-buffer buffer))))
  (when (eq *navigation* state) (setf *navigation* nil)))

(defun start-navigation ()
  (when *navigation* (error "Navigation already active"))
  (let* ((id (incf *navigation-counter*))
         (side (frame-leftside-window (current-frame)))
         (state (make-navigation :root (or (ignore-errors (lem-core/commands/project:find-root (buffer-directory))) (uiop:getcwd))
                                 :editor (current-window) :alive t :return-buffer (current-buffer)
                                 :original-side side :original-side-buffer (and side (window-buffer side))
                                 :original-side-width (and side (window-width side)))))
    (handler-case
        (progn
          (setf (navigation-page state) (make-buffer (format nil "*Yeditor Arquivos ~D*" id) :temporary t)
                (navigation-bar state) (make-buffer (format nil "*Yeditor navegação ~D*" id) :temporary t))
          (change-buffer-mode (navigation-page state) 'navigation-mode)
          (change-buffer-mode (navigation-bar state) 'navigation-mode)
          (setf (navigation-header state) (make-instance 'navigation-header :buffer (navigation-bar state) :use-modeline-p nil)
                *navigation* state)
          (render-navigation state)
          state)
      (error (condition) (stop-navigation state) (error condition)))))

(defun install-navigation-ui (component)
  (let ((state nil))
    (yeditor-tx:install-effect component :ui-state
                              (lambda () (setf state (start-navigation)))
                              :undo-thunk (lambda () (stop-navigation state)))))

(define-component le-navigation
  :version "0.1.0"
  :install (lambda (component context)
             (declare (ignore context))
             (list (install-navigation-ui component)
                   (install-hook component '*post-command-hook* 'after-navigation-command)
                   (install-variable component '*splash-function* #'yeditor-navigation-home)
                   (install-keybinding component *global-keymap* "F2" 'yeditor-navigation-home)
                   (install-keybinding component *global-keymap* "F3" 'yeditor-navigation-search))))
