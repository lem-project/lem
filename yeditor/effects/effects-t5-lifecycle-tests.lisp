(defpackage :yeditor-effects-t5-lifecycle-tests
  (:use :cl :rove :yeditor-tx :yeditor-effects))
(in-package :yeditor-effects-t5-lifecycle-tests)

(defvar *sentinel* :baseline)

(defclass test-timer-manager (lem/common/timer:timer-manager)
  ((mailbox :initarg :mailbox :reader manager-mailbox)))
(defmethod lem/common/timer:send-timer-notification ((manager test-timer-manager) callback)
  (lem-mailbox:send-message (manager-mailbox manager) callback))

(defun binding (keymap)
  (let ((prefix (lem:keymap-find keymap (lem:parse-keyspec "C-t"))))
    (when prefix (lem:prefix-suffix prefix))))

(deftest activation-time-snapshots
  (let ((*tx-pending* nil) (*tx-committed* nil) (*sentinel* :queued)
        (keymap (lem:make-keymap)))
    (install-variable 'snapshot '*sentinel* :active)
    (install-keybinding 'snapshot keymap "C-t" 'lem:forward-char)
    (install-command 'snapshot "t5-snapshot" (lambda () :active))
    (let ((baseline (make-instance 'yeditor-effects/e-command::yeditor-dynamic-command
                                   :name "t5-snapshot" :fn (lambda () :baseline))))
      (unwind-protect
           (progn
             (setf *sentinel* :baseline)
             (lem:define-key keymap "C-t" 'lem:backward-char)
             (lem:add-command "t5-snapshot" baseline)
             (handler-bind ((warning #'muffle-warning)) (tx-commit))
             (tx-rollback)
             (ok (eq *sentinel* :baseline))
             (ok (eq (binding keymap) 'lem:backward-char))
             (ok (eq (lem:find-command "t5-snapshot") baseline)))
        (tx-rollback)
        (lem:remove-command "t5-snapshot")))))

(deftest variable-overrides-unwind-lifo
  (let ((*tx-pending* nil) (*tx-committed* nil) (*sentinel* :baseline)
        (warnings 0))
    (let ((first (install-variable 'first '*sentinel* :first))
          (second (install-variable 'second '*sentinel* :second)))
      (handler-bind ((warning (lambda (c) (incf warnings) (muffle-warning c))))
        (tx-commit))
      (ok (plusp warnings) "variable overrides warn")
      (ok (eq *sentinel* :second))
      (funcall (cdr (assoc :inverse second)))
      (ok (eq *sentinel* :first) "inner inverse restores outer override")
      (funcall (cdr (assoc :inverse first)))
      (ok (eq *sentinel* :baseline)))))

(deftest all-five-effects-200-suspend-resume-pairs
  (let* ((*tx-pending* nil) (*tx-committed* nil)
         (yeditor-context::*component-registry* (make-hash-table))
         (*sentinel* :baseline)
         (keymap (lem:make-keymap))
         (buffer (lem:make-buffer "*t5-lifecycle*" :enable-undo-p nil))
         (attribute (lem:make-attribute :reverse t))
         (notifications (lem-mailbox:make-mailbox))
         (calls 0))
    (lem:define-key keymap "C-t" 'lem:backward-char)
    (yeditor-context:register-component
     'all-five :install
     (lambda (comp context)
       (declare (ignore context))
       (list (install-variable comp '*sentinel* :active)
             (install-keybinding comp keymap "C-t" 'lem:forward-char)
             (install-command comp "t5-all-five" (lambda () :executed))
             (install-overlay comp (lem:buffer-start-point buffer)
                                   (lem:buffer-end-point buffer) attribute)
             (install-timer comp 1 (lambda () (incf calls)) :repeat nil))))
    (labels ((check-active ()
               (ok (eq *sentinel* :active))
               (ok (eq (binding keymap) 'lem:forward-char))
               (ok (eq (lem:execute nil (lem:find-command "t5-all-five") nil) :executed))
               (ok (= 1 (length (lem:buffer-overlays buffer)))))
             (check-inactive ()
               (ok (eq *sentinel* :baseline))
               (ok (eq (binding keymap) 'lem:backward-char))
               (ok (null (lem:find-command "t5-all-five")))
               (ok (null (lem:buffer-overlays buffer)))))
      (unwind-protect
           (lem/common/timer:with-timer-manager (make-instance 'test-timer-manager :mailbox notifications)
             (handler-bind ((warning #'muffle-warning))
               (yeditor-context:install-component 'all-five)
               (dotimes (i 200)
                 (check-active)
                 ;; A real worker delivers a callback. Keep it queued until undo.
                 (let ((callback (lem-mailbox:receive-message notifications :timeout 2)))
                   (ok callback "real timer delivers a notification")
                   (let ((before calls))
                     (when callback (funcall callback))
                     (ok (= calls (1+ before)) "active timer executes"))
                   (yeditor-context:toggle-component 'all-five)
                   (check-inactive)
                   (let ((before calls))
                     (when callback (funcall callback))
                     (ok (= calls before) "queued callbacks are inert after undo")
                     (yeditor-context:toggle-component 'all-five)
                     (when callback (funcall callback))
                     (ok (= calls before) "old activation remains inert after resume"))))
               (check-active)
               (yeditor-context:uninstall-component 'all-five)
               ;; Fresh installs also cover repeated creation and destruction of handles.
               (dotimes (i 200)
                 (yeditor-context:install-component 'all-five)
                 (check-active)
                 (yeditor-context:uninstall-component 'all-five)
                 (check-inactive))
               (yeditor-context:uninstall-component 'all-five)
               (check-inactive)
               (yeditor-context:uninstall-component 'all-five)
               (check-inactive)))
        (yeditor-context:uninstall-component 'all-five)
        (lem:remove-command "t5-all-five")
        (lem:delete-buffer buffer)))))

(deftest key-sequences-restore-prefix-structure
  (dolist (baseline '(nil lem:backward-char))
    (let ((*tx-pending* nil) (*tx-committed* nil)
          (keymap (lem:make-keymap)))
      (when baseline (lem:define-key keymap "C-t" baseline))
      (dotimes (i 200)
        (install-keybinding 'sequence keymap "C-t a" 'lem:forward-char)
        (tx-commit)
        (ok (lem:keymap-find keymap (lem:parse-keyspec "C-t a")))
        (lem:define-key keymap "C-z" 'lem:backward-char)
        (tx-rollback)
        (ok (eq (binding keymap) baseline) "prefix command or absence restored")
        (ok (lem:keymap-find keymap (lem:parse-keyspec "C-z"))
            "unrelated bindings survive rollback")))))
