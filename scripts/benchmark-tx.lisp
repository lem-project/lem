(load ".qlot/setup.lisp")

(asdf:load-asd "/home/yuri/Documents/yeditor/yeditor/tx/yeditor-tx.asd")
(asdf:load-system :yeditor-tx)

(defun bench-rep (iterations)
  (let (times)
    (dotimes (i iterations)
      (let ((start (get-internal-run-time)))
        (yeditor-tx:with-transaction)
        (let ((delta (/ (- (get-internal-run-time) start) internal-time-units-per-second)))
          (push (* delta 1e6) times))))
    (nreverse times)))

(defun report-stats (times)
  (let* ((sorted (sort (copy-list times) #'<))
         (len (length sorted))
         (p50 (nth (floor (* 0.5 (1- len))) sorted))
         (p95 (nth (floor (* 0.95 (1- len))) sorted))
         (p99 (nth (floor (* 0.99 (1- len))) sorted)))
    (format t "p50=~6,2F µs, p95=~6,2F µs, p99=~6,2F µs~%" p50 p95 p99)))

(let ((iterations 10000))
  (dotimes (rep 3)
    (format t "Repetition ~a~%" (1+ rep))
    (let ((times (bench-rep iterations)))
      (report-stats times))))
  (quit))