(load ".qlot/setup.lisp")
(asdf:load-asd "/home/yuri/Documents/yeditor/yeditor/tx/yeditor-tx.asd")
(asdf:load-system :yeditor-tx)
(defun bench (iterations)
  (let ((start (get-internal-run-time)))
    (dotimes (i iterations)
      (yeditor-tx:with-transaction))
    (/ (- (get-internal-run-time) start) internal-time-units-per-second)))

(let ((runs (list (bench 10000) (bench 10000) (bench 10000))))
  (format t "Runs (seconds): ~a~%" runs)
  (let* ((sorted (sort (copy-list runs) #'<))
         (p50 (nth (floor (* 0.5 (length sorted))) sorted))
         (p95 (nth (floor (* 0.95 (length sorted))) sorted)))
    (format t "p50=~a s, p95=~a s~%" p50 p95)))
(quit)
