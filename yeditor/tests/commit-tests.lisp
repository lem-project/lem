(defpackage :yeditor-tx/commit-tests
  (:use :cl)
  (:export #:run-tests))
(in-package :yeditor-tx/commit-tests)

(defvar *state* nil)

(defun signals-error-p (function)
  (handler-case (progn (funcall function) nil)
    (error () t)))

(defun test-commit-and-rollback ()
  (let ((log (yeditor-tx:make-transaction-log))
        (*state* nil)
        (trace nil))
    (yeditor-tx:with-transaction (log)
      (dotimes (i 5)
        (let ((value i))
          (yeditor-tx:install-effect
           :test :dummy
           (lambda () (push value *state*) (push (list :do value) trace))
           :undo-thunk (lambda () (pop *state*) (push (list :undo value) trace))))))
    (assert (null *state*))
    (assert (null (yeditor-tx:log-records log)))
    (yeditor-tx:commit log)
    (assert (equal '(4 3 2 1 0) *state*))
    (assert (= 5 (length (yeditor-tx:log-records log))))
    (yeditor-tx:commit log)
    (assert (= 5 (length *state*)))
    (yeditor-tx:rollback log)
    (assert (null *state*))
    (assert (equal '((:do 0) (:do 1) (:do 2) (:do 3) (:do 4)
                     (:undo 4) (:undo 3) (:undo 2) (:undo 1) (:undo 0))
                   (reverse trace)))
    (yeditor-tx:rollback log)
    (assert (null *state*))))

(defun test-failed-commit ()
  (let ((log (yeditor-tx:make-transaction-log))
        (*state* 10))
    (yeditor-tx:with-transaction (log)
      (yeditor-tx:install-effect :test :dummy (lambda () (incf *state*))
                                :undo-thunk (lambda () (decf *state*)))
      ;; A failing installer can mutate before signaling: its inverse is
      ;; captured before invocation and must run too.
      (yeditor-tx:install-effect :test :dummy
                                (lambda () (incf *state*) (error "install failed"))
                                :undo-thunk (lambda () (decf *state*))))
    (assert (signals-error-p (lambda () (yeditor-tx:commit log))))
    (assert (= 10 *state*))
    (assert (eq :rolled-back (yeditor-tx:transaction-state log)))
    (assert (signals-error-p (lambda () (yeditor-tx:commit log))))))

(defun test-nonlocal-exit ()
  (let ((log (yeditor-tx:make-transaction-log))
        (*state* 0))
    (yeditor-tx:with-transaction (log)
      (yeditor-tx:install-effect :test :dummy
                                (lambda () (incf *state*) (throw 'abort :escaped))
                                :undo-thunk (lambda () (decf *state*))))
    (assert (eq :escaped (catch 'abort (yeditor-tx:commit log))))
    (assert (zerop *state*))))

(defun test-undo-failure ()
  (let ((log (yeditor-tx:make-transaction-log))
        (*state* 0)
        (fail-p t))
    (yeditor-tx:with-transaction (log)
      (yeditor-tx:install-effect :test :first (lambda () (incf *state* 1))
                                :undo-thunk (lambda () (decf *state* 1)))
      (yeditor-tx:install-effect :test :second (lambda () (incf *state* 10))
                                :undo-thunk (lambda ()
                                              (when fail-p (error "undo failed"))
                                              (decf *state* 10))))
    (yeditor-tx:commit log)
    (assert (signals-error-p (lambda () (yeditor-tx:rollback log))))
    ;; Other inverses still run; a failed inverse remains retryable.
    (assert (= 10 *state*))
    (assert (eq :rollback-failed (yeditor-tx:transaction-state log)))
    (setf fail-p nil)
    (yeditor-tx:rollback log)
    (assert (zerop *state*))))

(defun test-commit-preserves-error-cause ()
  (let ((log (yeditor-tx:make-transaction-log))
        (cause (make-condition 'simple-error :format-control "original install failure"))
        (fail-undo-p t)
        (*state* 0))
    (yeditor-tx:with-transaction (log)
      (yeditor-tx:install-effect
       :test :dummy (lambda () (incf *state*) (error cause))
       :undo-thunk (lambda ()
                     (when fail-undo-p (error "inverse failure"))
                     (decf *state*))))
    (let ((failure (handler-case (progn (yeditor-tx:commit log) nil)
                     (yeditor-tx:rollback-failure (condition) condition))))
      (assert failure)
      (assert (eq cause (yeditor-tx:rollback-cause failure)))
      (assert (= 1 (length (yeditor-tx:rollback-errors failure)))))
    (setf fail-undo-p nil)
    (yeditor-tx:rollback log)
    (assert (zerop *state*))))

(defun test-handles-and-context ()
  (let ((log (yeditor-tx:make-transaction-log))
        (*state* 0))
    (yeditor-tx:with-transaction (log)
      (let ((cancelled (yeditor-context:effect
                        :test :dummy (lambda () (incf *state* 100))
                        :undo-thunk (lambda () (decf *state* 100)))))
        (yeditor-tx:undo-effect cancelled)
        (assert (eq :cancelled (yeditor-tx:effect-state cancelled))))
      (let ((handle (yeditor-context:effect
                     :test :dummy (lambda () (incf *state*))
                     :undo-thunk (lambda () (decf *state*)))))
        (yeditor-tx:commit log)
        (assert (= 1 *state*))
        (yeditor-tx:undo-effect handle)
        (yeditor-tx:undo-effect handle)
        (assert (zerop *state*))))
    (yeditor-tx:rollback log)
    (assert (zerop *state*))
    (assert (signals-error-p
             (lambda () (yeditor-tx:with-transaction (log)
                          (yeditor-tx:install-effect :test :dummy (lambda () nil)
                                                    :undo-thunk (lambda () nil))))))))

(defun test-workspace-group ()
  (let ((log (yeditor-tx:make-transaction-log))
        (*state* nil))
    (yeditor-tx:with-transaction (log)
      (yeditor-tx:with-workspace-transaction (:workspace)
        (dotimes (i 3)
          (let ((value i))
            (yeditor-tx:install-effect :workspace :buffer-modification
                                      (lambda () (push value *state*))
                                      :undo-thunk (lambda () (pop *state*)))))))
    (yeditor-tx:commit log)
    (assert (equal '(2 1 0) *state*))
    (assert (= 1 (length (yeditor-tx:log-records log))))
    (assert (= 2 (yeditor-tx:transaction-kind
                  (cdr (assoc :payload (first (yeditor-tx:log-records log)))))))
    (yeditor-tx:rollback log)
    (assert (null *state*))))

(defun test-random-reversibility ()
  ;; Deterministic PRNG: reproducible across Lisp implementations.
  (loop :for seed :from 1 :to 20
        :do (let ((random-state seed)
                  (log (yeditor-tx:make-transaction-log))
                  (handles nil)
                  (*state* 7))
              (flet ((next-random ()
                       (setf random-state
                             (mod (+ (* random-state 1664525) 1013904223)
                                  (expt 2 32)))))
                (yeditor-tx:with-transaction (log)
                  (dotimes (i 100)
                    (if (and handles (logbitp 16 (next-random)))
                        (yeditor-tx:undo-effect (pop handles))
                        (push (yeditor-tx:install-effect
                               :test :dummy (lambda () (incf *state*))
                               :undo-thunk (lambda () (decf *state*)))
                              handles))))
                (yeditor-tx:commit log)
                ;; Cancel pending effects above; uninstall applied effects here.
                (dolist (handle handles)
                  (when (logbitp 16 (next-random))
                    (yeditor-tx:undo-effect handle)))
                (yeditor-tx:rollback log)
                (assert (= 7 *state*))))))

(defun test-reentrancy-and-validation ()
  (dolist (operation (list #'yeditor-tx:commit #'yeditor-tx:rollback))
    (let ((log (yeditor-tx:make-transaction-log)))
      (yeditor-tx:with-transaction (log)
        (yeditor-tx:install-effect :test :dummy
                                  (lambda () (funcall operation log))
                                  :undo-thunk (lambda () nil)))
      (assert (signals-error-p (lambda () (yeditor-tx:commit log))))
      (assert (eq :rolled-back (yeditor-tx:transaction-state log)))))
  (let ((log (yeditor-tx:make-transaction-log)))
    (yeditor-tx:with-transaction (log)
      (assert (signals-error-p
               (lambda () (yeditor-tx:install-effect :test :dummy (lambda () nil))))))))

(defun test-workspace-failure ()
  (let ((log (yeditor-tx:make-transaction-log))
        (*state* 0))
    (yeditor-tx:with-transaction (log)
      (yeditor-tx:with-workspace-transaction (:test)
        (yeditor-tx:install-effect :test :first (lambda () (incf *state*))
                                  :undo-thunk (lambda () (decf *state*)))
        (yeditor-tx:install-effect :test :second (lambda () (error "child failed"))
                                  :undo-thunk (lambda () nil))))
    (assert (signals-error-p (lambda () (yeditor-tx:commit log))))
    (assert (zerop *state*))
    (assert (eq :rolled-back (yeditor-tx:transaction-state log)))))

(defun run-tests ()
  "Run the T2 behavior and reproducible reversibility tests."
  (mapc #'funcall '(test-commit-and-rollback test-failed-commit
                   test-nonlocal-exit test-undo-failure test-commit-preserves-error-cause
                   test-handles-and-context
                   test-workspace-group test-random-reversibility
                   test-reentrancy-and-validation test-workspace-failure))
  (format t "T2: 10 test groups passed, including 20 seeds x 100 operations.~%")
  t)
