(defpackage :yeditor-components/lsp-tests
  (:use :cl :rove :lem :yeditor-context :yeditor-components/lsp))
(in-package :yeditor-components/lsp-tests)

(defclass event-timer-manager (lem/common/timer:timer-manager) ())
(defmethod lem/common/timer:send-timer-notification ((manager event-timer-manager) callback)
  (send-event callback))

(defun python-buffer (root name)
  (let ((buffer (make-buffer name :directory (namestring root)))
        (lem-lsp-mode:*disable* t))
    (setf (buffer-filename buffer) (merge-pathnames name root))
    (change-buffer-mode buffer 'lem-python-mode:python-mode)
    buffer))

(defun buffer-hooks (buffer)
  (mapcar (lambda (name) (copy-list (variable-value name :buffer buffer)))
          '(kill-buffer-hook after-save-hook before-change-functions self-insert-after-hook)))

(defun wait-for (predicate)
  (loop :with deadline := (+ (get-internal-real-time) (* 5 internal-time-units-per-second))
        :until (funcall predicate)
        :do (when (> (get-internal-real-time) deadline) (return nil))
            (receive-event 0.01)
        :finally (return t)))

(deftest python-projects-have-isolated-reversible-servers
  (lem/common/timer:with-timer-manager (make-instance 'event-timer-manager)
   (lem-fake-interface:with-fake-interface ()
    (let* ((root (merge-pathnames (format nil "yeditor-t13-~D/" (random 1000000000))
                                 (uiop:temporary-directory)))
           (a (merge-pathnames "a/" root)) (b (merge-pathnames "b/" root))
           (launcher (merge-pathnames "pyright" root))
           (trace (merge-pathnames "initialize.jsonl" root))
           (spec (lem-lsp-mode/spec:get-language-spec 'lem-python-mode:python-mode))
           (command (lem-lsp-mode/spec:spec-command spec))
           (buffers nil))
      (ensure-directories-exist a) (ensure-directories-exist b)
      (dolist (dir (list a b))
        (with-open-file (out (merge-pathnames "pyproject.toml" dir) :direction :output)
          (write-line "[project]" out)))
      (dolist (name '("a/a.py" "a/same-project.py" "a/borrowed.py" "b/b.py"))
        (with-open-file (out (merge-pathnames name root) :direction :output)
          (write-line "value = 1" out)))
      (with-open-file (out launcher :direction :output)
        (write-line "#!/bin/sh" out)
        (write-line "exec python3 \"$@\"" out))
      (uiop:run-program (list "chmod" "+x" (namestring launcher)))
      (setf (lem-lsp-mode/spec:spec-command spec)
            (list (namestring launcher)
                  (namestring (asdf:system-relative-pathname
                               "yeditor-components" "test-data/fake-lsp-server.py"))
                  (namestring trace)))
      (unwind-protect
           (progn
             (setf buffers (list (python-buffer a "a.py") (python-buffer b "b.py")
                                 (python-buffer a "same-project.py")
                                 (python-buffer a "borrowed.py")))
             (let ((hooks (mapcar #'buffer-hooks buffers))
                   (global-hooks (copy-list *find-file-hook*))
                   (disable lem-lsp-mode:*disable*)
                   (actions yeditor-components/palette:*palette-actions*)
                   (all-buffers (copy-list (buffer-list))))
               (dotimes (i 100)
                 (install-component 'le-lsp)
                 (switch-to-buffer (first buffers))
                 (yeditor-components/palette:call-with-theme-preview
                  (lambda (preview) (declare (ignore preview)) "LSP: start for this project"))
                 (let* ((wa (lsp-start-buffer (first buffers)))
                        (wb (lsp-start-buffer (second buffers)))
                        (ready nil) (ready-b nil))
                   (ok (not (eq wa wb)) "same language in distinct projects needs separate servers")
                   (ok (eq wa (lsp-start-buffer (third buffers))) "same project reuses its server")
                   (ok (= 2 (length *lsp-sessions*)))
                   (ok (eq wa (lem-lsp-mode:buffer-lsp-session (first buffers))))
                   (ok (eq wb (lem-lsp-mode:buffer-lsp-session (second buffers))))
                   (lem-lsp-mode:start-lsp-session (first buffers) :then (lambda () (setf ready t)))
                   (lem-lsp-mode:start-lsp-session (second buffers) :then (lambda () (setf ready-b t)))
                   (ok (wait-for (lambda () (and ready ready-b))) "both fake pyrights complete initialize")
                   (when (zerop i)
                     (let ((roots (mapcar (lambda (line) (gethash "rootUri" (yason:parse line)))
                                          (uiop:read-file-lines trace))))
                       (ok (= 2 (length (remove-duplicates roots :test #'equal)))
                           "servers receive different project roots in initialize")))
                   (let ((yeditor-tx:*tx-pending* nil) (yeditor-tx:*tx-committed* nil))
                     (let ((borrow (yeditor-effects:install-lsp-session 'borrow (fourth buffers))))
                       (yeditor-tx:tx-commit)
                       (ok (eq wa (lem-lsp-mode:buffer-lsp-session (fourth buffers))))
                       (funcall (cdr (assoc :inverse borrow)))
                       (ok (null (lem-lsp-mode:buffer-lsp-session (fourth buffers))))
                       (ok (equal (fourth hooks) (buffer-hooks (fourth buffers))))
                       (ok (lem-lsp-mode:lsp-session-alive-p wa) "borrower keeps the owned server alive")))
                   (switch-to-buffer (first buffers))
                   (ok (equal " LSP:python " (lsp-modeline-segment (current-window))))
                   (yeditor-components/palette:call-with-theme-preview
                    (lambda (preview) (declare (ignore preview)) "LSP: stop for this project"))
                   (ok (equal " LSP:off " (lsp-modeline-segment (current-window))))
                   (switch-to-buffer (second buffers))
                   (ok (equal " LSP:python " (lsp-modeline-segment (current-window))))
                   (ok (lem-lsp-mode:lsp-session-alive-p wb) "stopping A preserves B")
                   (ok (null (lsp-session-for (third buffers))))
                   (uninstall-component 'le-lsp)
                   (ok (not (lem-lsp-mode:lsp-session-alive-p wa)))
                   (ok (not (lem-lsp-mode:lsp-session-alive-p wb)))
                   (receive-event 0)
                   (ok (null *lsp-sessions*))
                   (ok (every (lambda (buffer) (null (lem-lsp-mode:buffer-lsp-session buffer))) buffers))
                   (ok (eq actions yeditor-components/palette:*palette-actions*))
                   (ok (null (set-exclusive-or all-buffers (buffer-list))) "no buffer leaks")
                   (ok (equal hooks (mapcar #'buffer-hooks buffers)) "restore buffer hooks after initialize")
                   (ok (equal global-hooks *find-file-hook*))
                   (ok (eq disable lem-lsp-mode:*disable*))))))
        (uninstall-component 'le-lsp)
        (setf (lem-lsp-mode/spec:spec-command spec) command)
        (dolist (buffer buffers) (delete-buffer buffer))
        (uiop:delete-directory-tree root :validate t))))))

(deftest missing-server-offers-guidance-without-starting-a-process
  (lem-fake-interface:with-fake-interface ()
    (let* ((spec (lem-lsp-mode/spec:get-language-spec 'lem-python-mode:python-mode))
           (command (lem-lsp-mode/spec:spec-command spec))
           (buffer (python-buffer (uiop:temporary-directory) "missing-t13.py"))
           (condition nil) (prompt nil) (instructions nil))
      (unwind-protect
           (progn
             (install-component 'le-lsp)
             (setf (lem-lsp-mode/spec:spec-command spec) '("yeditor-no-such-pyright"))
             (setf condition (handler-case (progn (lsp-start-buffer buffer) nil)
                               (lem-lsp-mode:not-found-program (c) c)))
             (ok condition)
             (yeditor-components/lsp::offer-lsp-installation
              condition :confirm (lambda (text) (setf prompt text) nil)
                        :present (lambda (text) (setf instructions text)))
             (ok (search "Install LSP?" prompt))
             (ok (null instructions) "declining does nothing")
             (yeditor-components/lsp::offer-lsp-installation
              condition :confirm (constantly t) :present (lambda (text) (setf instructions text)))
             (ok (search "pip install python-lsp-server" instructions))
             (ok (null *lsp-sessions*)))
        (setf (lem-lsp-mode/spec:spec-command spec) command)
        (uninstall-component 'le-lsp)
        (delete-buffer buffer)))))

(deftest borrowed-session-detaches-each-acquired-buffer
  (lem/common/timer:with-timer-manager (make-instance 'event-timer-manager)
   (lem-fake-interface:with-fake-interface ()
    (let* ((first (yeditor-components-tests::lang-buffer "external.fake" 'yeditor-components-tests::yeditor-fake-lang-mode))
           (second (yeditor-components-tests::lang-buffer "borrow.fake" 'yeditor-components-tests::yeditor-fake-lang-mode))
           (hooks (buffer-hooks second))
           (workspace nil) (ready nil))
      (unwind-protect
           (progn
             (setf workspace (lem-lsp-mode:start-lsp-session first :then (lambda () (setf ready t))))
             (ok (wait-for (lambda () ready)))
             (install-component 'le-lsp)
             (ok (eq workspace (lsp-start-buffer first)))
             (ok (eq workspace (lsp-start-buffer second)))
             (uninstall-component 'le-lsp)
             (ok (lem-lsp-mode:lsp-session-alive-p workspace))
             (ok (eq workspace (lem-lsp-mode:buffer-lsp-session first)))
             (ok (null (lem-lsp-mode:buffer-lsp-session second)))
             (ok (equal hooks (buffer-hooks second))))
        (uninstall-component 'le-lsp)
        (when workspace (lem-lsp-mode:stop-lsp-session workspace))
        (delete-buffer first) (delete-buffer second))))))
